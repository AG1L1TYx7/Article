# Copy to .env and fill in real values. Never commit .env itself.
#
# First-run setup (nothing below is needed for local development):
#   1. npm run seed                       — starter categories
#   2. npm run bootstrap:staff -- --email you@example.com --role ADMIN
#   3. npm run dev, log in, scan the MFA QR (admins only)
#
# In production the server refuses to start until the essentials are set
# (a real AUTH_SECRET, the public https address, an email provider):
# run "npm run check:production" to see the same report before deploying.
# ALLOW_PRODUCTION_FALLBACKS=1 downgrades that to a warning, for a staging
# box only. See docs/production-checklist.md.
#
# Everything below has a working local fallback until you fill it in:
#   - no RESEND_API_KEY  -> emails are written to .email-dev-outbox.log
#   - no S3_*            -> uploads go to ./.local-uploads
#   - no UPSTASH_*       -> rate limiting uses an in-process counter
#                           (fine for one dev process, NOT for multi-instance deploys)
#   - no TURNSTILE_*     -> the registration CAPTCHA is skipped entirely

# MySQL or MariaDB. The XAMPP bundle runs MariaDB on 3307 here, because
# a separately installed MySQL 8 already holds 3306.
#
# The server needs innodb_ft_min_token_size=2, or searching for "AI",
# "EU" or "US" silently matches nothing. See docs/database.md.
DATABASE_URL="mysql://root@127.0.0.1:3307/news_platform"

AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Object storage (S3-compatible) for uploaded photo/video.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MEDIA_PUBLIC_BASE_URL=""

# Redis (Upstash) — rate limiting.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Transactional email (Resend).
RESEND_API_KEY=""
EMAIL_FROM="News Platform <no-reply@example.com>"

# Who is legally responsible for the site. Printed on /privacy and /terms
# and highlighted there until set — a privacy policy that names nobody
# is not one. See docs/compliance.md.
LEGAL_ENTITY=""
LEGAL_ADDRESS=""
LEGAL_CONTACT_EMAIL=""
LEGAL_JURISDICTION=""
LEGAL_DPO_EMAIL=""
# Days the security audit log is kept before automatic deletion (default 365).
AUDIT_RETENTION_DAYS=""

# Analytics: which request header carries the reader's country code.
# Cloudflare (CF-IPCountry), Vercel (X-Vercel-IP-Country) and cPanel's
# mod_geoip (GEOIP_COUNTRY_CODE) are recognised automatically; name any
# other here. The app never looks the IP up itself, so with nothing in
# front of it the country is "unknown". Put the site behind Cloudflare's
# free tier to get countries on cPanel.
GEO_COUNTRY_HEADER=""

# Text messages (phone-number verification), via Twilio.
# Leave blank to run without it: codes are written to .sms-dev-outbox.log
# instead, which is how the flow is tested locally. TWILIO_FROM is your
# Twilio number in E.164 form (+14155550100) or a messaging service SID.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Web Push (breaking-news alerts to phones and desktops).
# Generate the pair once with:  npm run push:keys
# and paste the two lines it prints here. Leave all three blank to run
# without push: the toggle simply does not appear. The subject is who a
# push service may contact about abuse — a mailto: or https: URL; it
# falls back to LEGAL_CONTACT_EMAIL. Changing the keys later silently
# orphans every existing subscription, so treat them like AUTH_SECRET.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Cloudflare Turnstile (CAPTCHA on registration).
# Leave both blank to disable the check entirely (local dev default).
# The site key must carry the NEXT_PUBLIC_ prefix to reach the browser.
#
# Cloudflare publishes dummy keys, so you can exercise this without an
# account (https://developers.cloudflare.com/turnstile/troubleshooting/testing/):
#   always passes:  site 1x00000000000000000000AA  secret 1x0000000000000000000000000000000AA
#   always blocks:  site 2x00000000000000000000AB  secret 2x0000000000000000000000000000000AA
# Site key and secret key must be a matching pair or verification fails.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Malware scanning for uploads (ClamAV's clamd daemon), as a second
# opinion on the re-encoded bytes. Leave blank to run without it: every
# file is still re-encoded (images by sharp, video and audio by ffmpeg),
# which is what actually neutralises it. With a scanner configured, its
# verdict is final. docker-compose.yml ships a clamav service; "clamav"
# is its name there.
CLAMAV_HOST=""
CLAMAV_PORT="3310"

# Video and audio re-encoding (ffmpeg). Leave blank to use the binary the
# ffmpeg-static package downloads at npm install, which works on a laptop
# and on cPanel. The Docker image installs the distribution's ffmpeg and
# sets this instead. If neither exists, video and audio uploads are
# refused (images still work). See docs/media.md.
FFMPEG_PATH=""
