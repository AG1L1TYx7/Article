// News & Article Platform — data model
// See docs/ for the full architecture and security plan this schema implements.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum Role {
  READER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  emailVerifiedAt    DateTime?
  passwordHash       String?
  name               String
  handle             String     @unique
  avatarUrl          String?
  role               Role       @default(READER)
  status             UserStatus @default(ACTIVE)
  mfaSecret          String?
  mfaEnabled         Boolean    @default(false)
  // One-time codes for a lost authenticator: a JSON array of keyed
  // hashes, each removed as it is used. Shown to the person once, at
  // enrolment. See lib/auth/recoveryCodes.ts.
  mfaRecoveryCodes   String?    @db.Text
  // A verified phone number, for account recovery and alerts. Stored
  // encrypted (AES-256-GCM under AUTH_SECRET) so it can be shown back to
  // its owner, with a keyed hash beside it so uniqueness can be enforced
  // without the number itself being indexed. See lib/phone.ts.
  phoneEncrypted     String?
  phoneHash          String?    @unique @db.VarChar(64)
  phoneVerifiedAt    DateTime?
  // The one-time code sent by SMS, as a keyed hash; single use, ten
  // minutes, five attempts.
  phoneCodeHash      String?    @db.VarChar(64)
  phoneCodeExpires   DateTime?
  phoneCodeAttempts  Int        @default(0)
  // A new address waiting for its confirmation link. The old address
  // stays in force until the link is used.
  pendingEmail       String?
  // Set when an admin creates the account (or a temporary password is
  // issued): proxy.ts sends the person to /account/password before any
  // other page until they have chosen their own. See lib/auth/config.ts.
  mustChangePassword Boolean    @default(false)
  // When they ticked "I agree to the terms and privacy policy" at
  // registration — the record of consent GDPR Art. 7(1) asks for.
  termsAcceptedAt    DateTime?
  // Set by "Delete my account". The row stays so comments and audit
  // entries keep their foreign keys, but every personal field on it is
  // blanked and it can never sign in again. See lib/accountDeletion.ts.
  anonymisedAt       DateTime?
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?
  // Bumped to instantly invalidate every outstanding JWT for this user —
  // "log out everywhere" and forced-logout-on-ban, without database sessions.
  // See src/lib/auth/config.ts for why Credentials + JWT forced this design.
  sessionVersion     Int        @default(0)
  lastLoginAt        DateTime?
  lastLoginIp        String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  accounts            Account[]
  sessions            Session[]
  articles            Article[]          @relation("ArticleAuthor")
  comments            Comment[]
  reactions           Reaction[]
  bookmarks           Bookmark[]
  follows             Follow[]           @relation("FollowFollower")
  followedBy          Follow[]           @relation("FollowTarget")
  reports             Report[]           @relation("ReportReporter")
  handledReports      Report[]           @relation("ReportHandler")
  auditLogs           AuditLog[]
  media               Media[]
  notifications       Notification[]     @relation("NotificationRecipient")
  causedNotifications Notification[]     @relation("NotificationActor")
  pushSubscriptions   PushSubscription[]

  @@index([role])
  @@index([status])
}

// Auth.js (NextAuth) required tables — database sessions so any session is
// instantly revocable (see security blueprint: "log out everywhere").
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

enum ArticleStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Article {
  id         String        @id @default(cuid())
  slug       String        @unique
  title      String
  dek        String?
  bodyJson   Json
  bodyHtml   String        @db.Text
  // Plain text extracted from bodyHtml at write time, purely so search
  // can match article bodies. Indexing bodyHtml directly would match on
  // markup ("div", "href") rather than words a reader typed.
  searchText String?       @db.Text
  excerpt    String?
  status     ArticleStatus @default(DRAFT)
  isBreaking Boolean       @default(false)
  // Published without a byline. Readers see "Anonymous"; the newsroom,
  // the audit log and the author still know whose it is. Followers of
  // the author are not alerted, since that would name them.
  anonymous  Boolean       @default(false)
  locale     String        @default("en")
  viewCount  Int           @default(0)

  seoTitle       String?
  seoDescription String?
  coverImageId   String?

  authorId   String
  categoryId String?

  // Links a translation to the article it translates. A story published
  // in one language and then translated is two Article rows, each with
  // its own slug, body and locale, joined here so the page can offer
  // "Read this in …" and emit hreflang alternates. See docs/i18n.md.
  translationOfId String?

  publishedAt  DateTime?
  scheduledFor DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  author        User      @relation("ArticleAuthor", fields: [authorId], references: [id])
  category      Category? @relation(fields: [categoryId], references: [id])
  coverImage    Media?    @relation("ArticleCoverImage", fields: [coverImageId], references: [id])
  translationOf Article?  @relation("ArticleTranslations", fields: [translationOfId], references: [id], onDelete: SetNull)
  translations  Article[] @relation("ArticleTranslations")

  tags           ArticleTag[]
  media          Media[]              @relation("ArticleMedia")
  links          ArticleLink[]
  references     ArticleReference[]
  comments       Comment[]
  reactions      Reaction[]
  bookmarks      Bookmark[]
  reports        Report[]
  notifications  Notification[]
  viewDays       ArticleViewDaily[]
  viewDimensions ViewDimensionDaily[]
  readDays       ArticleReadDaily[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  // MATCH ... AGAINST requires a real FULLTEXT index — unlike Postgres,
  // MySQL cannot compute one per row at query time. MATCH must also name
  // exactly the columns some index was built over, which is why there are
  // four rather than one.
  //
  // The combined index decides *whether* a row matches. The three
  // single-column ones exist so relevance can be scored per column and
  // weighted, which is how a headline match outranks a passing mention
  // halfway down the body. Postgres did that with setweight() on a single
  // tsvector; MySQL has no equivalent, so it costs three more indexes.
  @@fulltext([title, dek, searchText])
  @@fulltext([title])
  @@fulltext([dek])
  @@fulltext([searchText])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  articles    Article[]
  follows     Follow[]
}

model Tag {
  id       String       @id @default(cuid())
  slug     String       @unique
  name     String
  articles ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

// The terms a file is published under. See src/lib/mediaRights.ts for the
// human names, the licence deed URLs and what each one requires (a
// creator's name for CC BY, a note explaining the permission for OTHER).
enum MediaLicense {
  OWN_WORK
  PERMISSION
  CC0
  CC_BY
  CC_BY_SA
  CC_BY_ND
  CC_BY_NC
  CC_BY_NC_SA
  CC_BY_NC_ND
  PUBLIC_DOMAIN
  OTHER
}

enum ScanStatus {
  PENDING
  CLEAN
  FLAGGED
}

// Uploaded files are not publicly servable until scanStatus = CLEAN.
// See security blueprint: files go client -> pre-signed URL -> object storage,
// then are re-encoded and malware-scanned before this row is marked clean.
model Media {
  id           String     @id @default(cuid())
  type         MediaType
  storageKey   String     @unique
  url          String
  contentType  String
  altText      String?
  width        Int?
  height       Int?
  durationSecs Int?
  sizeBytes    Int?
  checksum     String
  scanStatus   ScanStatus @default(PENDING)
  uploadedById String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt

  // Attribution and rights. Nothing here is personal data about a reader;
  // it is the record of who made the file and under what terms it is
  // published, shown under the file and in the article's credits. An
  // article cannot be published while any of its files lacks a licence
  // and a confirmation (rightsConfirmedAt) from the person who added it.
  title             String?
  caption           String?       @db.Text
  credit            String?
  sourceName        String?
  sourceUrl         String?       @db.VarChar(2000)
  license           MediaLicense?
  rightsNote        String?       @db.Text
  rightsConfirmedAt DateTime?
  // A written version of audio or video, for readers who cannot hear it
  // and for search engines. Optional but strongly encouraged.
  transcript        String?       @db.Text

  uploadedBy User      @relation(fields: [uploadedById], references: [id])
  articles   Article[] @relation("ArticleMedia")
  coverOf    Article[] @relation("ArticleCoverImage")

  @@index([scanStatus])
}

// A source the story cites, numbered in the order the author added it.
// A citation in the text is a link to #ref-<position>. Plain text
// throughout; the URL is checked to be http(s) before it is stored.
model ArticleReference {
  id          String   @id @default(cuid())
  articleId   String
  position    Int
  title       String   @db.VarChar(300)
  author      String?
  publication String?
  url         String?  @db.VarChar(2000)
  publishedOn String?  @db.VarChar(40)
  note        String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, position])
}

// A link an author attached to an article, with whatever the linked page
// said about itself. Those preview fields are a cached copy of a remote
// page fetched at attach time — never trusted, always rendered as text.
// See src/lib/linkPreview/ for how the fetch is kept from becoming SSRF.
model ArticleLink {
  id          String    @id @default(cuid())
  articleId   String
  url         String
  label       String?
  title       String?
  description String?
  siteName    String?
  // Null when the preview could not be fetched — the link is still shown,
  // just without the extra detail.
  fetchedAt   DateTime?
  createdAt   DateTime  @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

// ---------------------------------------------------------------------------
// Engagement
// ---------------------------------------------------------------------------

enum CommentStatus {
  PENDING
  APPROVED
  HIDDEN
  DELETED
}

model Comment {
  id        String        @id @default(cuid())
  articleId String
  userId    String
  parentId  String?
  body      String        @db.Text
  status    CommentStatus @default(PENDING)
  // Set only when the author rewrites their own comment. Distinct from
  // updatedAt, which also moves when a moderator changes the status —
  // readers should see "edited" for the former and nothing for the latter.
  editedAt  DateTime?
  // Shown to readers as "Anonymous". The account is still recorded —
  // moderators see it, replies still reach the author, and erasure still
  // works — it is only the public byline that is withheld.
  anonymous Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  article Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [userId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  reactions     Reaction[]
  reports       Report[]
  notifications Notification[]

  @@index([articleId, status])
  @@index([parentId])
}

enum ReactionType {
  LIKE
}

model Reaction {
  id        String       @id @default(cuid())
  userId    String
  type      ReactionType @default(LIKE)
  articleId String?
  commentId String?
  createdAt DateTime     @default(now())

  user    User     @relation(fields: [userId], references: [id])
  article Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@unique([userId, commentId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  authorId   String?
  categoryId String?
  createdAt  DateTime @default(now())

  follower User      @relation("FollowFollower", fields: [followerId], references: [id])
  author   User?     @relation("FollowTarget", fields: [authorId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  @@unique([followerId, authorId, categoryId])
}

enum NotificationType {
  COMMENT_REPLY
  COMMENT_APPROVED
  BREAKING_NEWS
}

// Tells a reader that something happened to their contribution: someone
// replied, or a held comment finally went live. Deliberately narrow —
// notifying on every like would be noise, and noise gets muted.
//
// Only ever created for content that is already public, so a notification
// can never reveal a comment still waiting on a moderator.
// Site-wide settings an admin changes from the dashboard: one row per
// key, JSON value. Read through lib/settings.ts, which supplies defaults
// and a short cache, never directly.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// One row per article per UTC day, bumped by the view counter. Exists so
// the analytics page can draw views over time; Article.viewCount alone
// only ever says "how many, in total". Written with INSERT ... ON
// DUPLICATE KEY UPDATE from lib/viewCount.ts, never through the client.
model ArticleViewDaily {
  articleId String
  day       DateTime @db.Date
  views     Int      @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, day])
  @@index([day])
}

// Where a day's views came from, one dimension at a time: country code,
// referrer class, device class. Counts only — no identifier, no IP, no
// user — so a row says "on this day, 14 views of this article came from
// FR", and nothing about who. Bumped from lib/analyticsCapture.ts.
model ViewDimensionDaily {
  articleId String
  day       DateTime @db.Date
  dimension String // "country" | "referrer" | "device"
  value     String // "FR", "search", "mobile", ...
  views     Int      @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, day, dimension, value])
  @@index([day, dimension])
}

// How articles are read, per day: how many readers sent a reading
// beacon, the active seconds they spent in total, how many reached the
// end, and the sum of their furthest scroll (0-100) for an average.
// Aggregates only; the beacon carries no identifier.
model ArticleReadDaily {
  articleId     String
  day           DateTime @db.Date
  reads         Int      @default(0)
  activeSeconds Int      @default(0)
  completions   Int      @default(0)
  scrollSum     Int      @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, day])
  @@index([day])
}

model Notification {
  id        String           @id @default(cuid())
  // The person being told.
  userId    String
  type      NotificationType
  // Who caused it. Null for anything the system did on its own.
  actorId   String?
  articleId String?
  commentId String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user    User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // Idempotency, not just tidiness: a comment can reach APPROVED more than
  // once (held, approved, edited back to held, approved again), and each
  // path tries to notify. This makes the second attempt a no-op instead of
  // a duplicate in someone's list.
  @@unique([userId, type, commentId])
  // The comment constraint above cannot deduplicate an article
  // notification: commentId is NULL for those, and Postgres lets NULLs
  // repeat in a unique index. Someone following both an author and the
  // section they published in would otherwise be told twice.
  @@unique([userId, type, articleId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// One browser that asked for push alerts. The endpoint is an opaque URL
// the browser's push service issued for this device; the two keys encrypt
// the payload so that service cannot read it. Nothing here identifies a
// person unless they were signed in when they subscribed, in which case
// the row is theirs and goes with their account. See lib/push.ts.
model PushSubscription {
  id           String    @id @default(cuid())
  // 2KB is generous; real endpoints are a few hundred characters. Unique
  // on the hash rather than the column: a utf8mb4 index cannot cover a
  // key this wide.
  endpoint     String    @db.VarChar(2048)
  endpointHash String    @unique @db.VarChar(64)
  p256dh       String    @db.VarChar(255)
  auth         String    @db.VarChar(255)
  userId       String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  // Set when the push service rejected a delivery for a reason other than
  // "gone"; the retention purge removes rows that have stayed failed.
  failedAt     DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([failedAt])
}

// ---------------------------------------------------------------------------
// Trust & safety
// ---------------------------------------------------------------------------

enum ReportReason {
  SPAM
  ABUSE
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  reason      ReportReason
  note        String?
  status      ReportStatus @default(OPEN)
  articleId   String?
  commentId   String?
  handledById String?
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?

  reporter  User     @relation("ReportReporter", fields: [reporterId], references: [id])
  handledBy User?    @relation("ReportHandler", fields: [handledById], references: [id])
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Append-only: every privileged action writes one row here. No update/delete
// path is exposed at the application layer — see security blueprint.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
