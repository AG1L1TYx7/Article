# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/src/generated/prisma

# dev-only email and SMS outboxes (see src/lib/email.ts, src/lib/sms.ts)
.email-dev-outbox.log
.sms-dev-outbox.log

# playwright
/test-results/
/playwright-report/
/blob-report/

# dev-only local media storage (see src/lib/storage.ts)
/.local-uploads/


# Editor/agent tooling. Local machine settings, and vendored third-party
# skill documentation that skills-lock.json can restore.
.claude/settings.local.json
# Regenerated by next dev on every run (see
# node_modules/next/dist/server/lib/generate-agent-files.js). Kept out of
# the repository: they are notes for AI coding tools, not for readers of
# this project.
/CLAUDE.md
/AGENTS.md
/.claude/skills/
/.agents/
/.windsurf/

# Built by npm run build:cpanel — an upload artifact, not source.
/cpanel-dist/

# Linux native-binary tarballs fetched by npm run build:cpanel (re-downloaded if missing).
/.cpanel-cache/

# Log of the dev server when started in the background.
.dev-server.log

# Database dumps from npm run db:backup. Keep them off the repository and off this disk.
/backups/
*.sql.gz

# SSH deploy key for GitHub Actions. The private half goes into a GitHub
# secret and must never be committed.
.deploy-key-tmp/

# The upload archive and its in-progress file (scripts/pack-cpanel.mjs).
cpanel-dist.zip
*.zip.building

# Runtime state: the deploy restart marker (src/lib/restartOnDeploy.ts).
/tmp/
